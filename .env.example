# ==============================================================================
# Environment Variables Example for Personal Expense Tracker
# Copy this file to .env.local for local development.
# NEVER commit .env or .env.local to version control!
# ==============================================================================

# Supabase Public Configuration (Accessible in browser and server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Supabase Server-Only Configuration (NEVER expose to client)
# Used exclusively by /api/ingest and server-side administrative actions
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# Ingest Webhook Secret Token (Must match x-ingest-token header sent by MacroDroid)
# Generate a secure 32+ character hex string: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
INGEST_SECRET_TOKEN=change_this_to_a_long_random_secret_token_min_32_chars

# Optional Ingestion Sender Filter
# If set, incoming SMS sender must match this regex (e.g. ^.*FEDBNK.*$ or FEDBNK).
# If left empty or unset, all senders will be accepted by /api/ingest.
ALLOWED_SENDER_PATTERN=

# Application URL (optional, defaults to request origin)
NEXT_PUBLIC_APP_URL=http://localhost:3000
